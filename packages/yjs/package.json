{
  "name": "@excalidraw/yjs",
  "version": "0.1.0",
  "description": "Generic Yjs scene binding primitives for Excalidraw hosts",
  "type": "module",
  "types": "./dist/types/yjs/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/yjs/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "gen:types": "rimraf dist/types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && yarn gen:types",
    "test": "vitest run --root ../.. packages/yjs/_tests_",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "lint": "eslint --ext .ts,.mjs src _tests_ --max-warnings 0"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "@excalidraw/common": "0.18.0",
    "@excalidraw/fractional-indexing": "3.3.0"
  },
  "devDependencies": {
    "yjs": "13.6.32"
  },
  "publishConfig": {
    "access": "public"
  }
}
