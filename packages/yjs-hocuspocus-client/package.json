{
  "name": "@excalidraw/yjs-hocuspocus-client",
  "version": "0.1.0",
  "description": "Host-injected Hocuspocus provider contracts for Excalidraw scenes",
  "type": "module",
  "types": "./dist/types/yjs-hocuspocus-client/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/yjs-hocuspocus-client/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "gen:types": "rimraf dist/types && tsc",
    "build:esm": "rimraf dist && node ../../scripts/buildBase.js && yarn gen:types",
    "build": "yarn build:esm",
    "test": "vitest run --root ../.. --config packages/yjs-hocuspocus-client/_tests_/vitest.config.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p _tests_/tsconfig.json",
    "lint": "eslint --ext .ts src _tests_ --max-warnings 0"
  },
  "peerDependencies": {
    "@excalidraw/yjs": "0.1.0",
    "@hocuspocus/provider": "4.6.0",
    "yjs": "13.6.32"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hocuspocus/server": "4.6.0",
    "@types/ws": "8.18.1",
    "ws": "8.17.1",
    "@hocuspocus/provider": "4.6.0",
    "yjs": "13.6.32",
    "y-protocols": "1.0.7"
  }
}
