{
  "name": "@excalidraw/agent-tool",
  "version": "0.1.0",
  "description": "Typed Excalidraw Agent semantic tools",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "types": "./dist/types/agent-tool/src/index.d.ts",
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/agent-tool/src/index.d.ts",
      "development": "./dist/dev/index.js",
      "production": "./dist/prod/index.js",
      "default": "./dist/prod/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "gen:types": "rimraf dist/types && tsc",
    "build:esm": "yarn docs:generate && rimraf dist && node ../../scripts/buildBase.js && yarn gen:types",
    "build": "yarn build:esm",
    "test": "vitest run --root ../.. --project agent-tool",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "lint": "eslint --ext .ts src _tests_ --max-warnings 0",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.6.0",
    "@types/jsdom": "21.1.7",
    "yjs": "13.6.32"
  },
  "peerDependencies": {
    "@excalidraw/yjs": "0.1.0",
    "@excalidraw/yjs-hocuspocus-client": "0.1.0"
  },
  "dependencies": {
    "@excalidraw/common": "0.18.0",
    "@excalidraw/element": "0.18.0",
    "@excalidraw/excalidraw": "0.18.0",
    "@excalidraw/yjs": "file:../yjs",
    "@excalidraw/yjs-hocuspocus-client": "file:../yjs-hocuspocus-client",
    "@napi-rs/canvas": "1.1.1",
    "jsdom": "22.1.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
