      "created": 1,
      "link": null,
      "locked": false,
      "text": "7．缩放下的一致性",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7．缩放下的一致性",
      "autoResize": true,
      "lineHeight": 1.15,
      "labelPosition": null
    },
    {
      "id": "id21",
      "type": "text",
      "x": 80,
      "y": 2648,
      "width": 490,
      "height": 64,
      "angle": 0,
      "strokeColor": "#1f2329",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "groupIds": [],
      "index": null,
      "roundness": null,
      "seed": 1,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "created": 1,
      "link": null,
      "locked": false,
      "text": "① 把画布缩放到 200%（Ctrl/⌘ + 滚轮，或右下角缩放控件）。\n② 悬停手柄看读数。\n③ 再缩到 50% 看一次。",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① 把画布缩放到 200%（Ctrl/⌘ + 滚轮，或右下角缩放控件）。\n② 悬停手柄看读数。\n③ 再缩到 50% 看一次。",
      "autoResize": true,
      "lineHeight": 1.15,
      "labelPosition": null
    },
    {
      "id": "id22",
