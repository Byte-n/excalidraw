    },
    {
      "id": "id9",
      "type": "text",
      "x": 80,
      "y": 1148,
      "width": 512,
      "height": 64,
      "angle": 0,
      "strokeColor": "#1f2329",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
