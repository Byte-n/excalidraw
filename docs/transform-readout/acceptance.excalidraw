      "updated": 1,
      "created": 1,
      "link": null,
      "locked": false,
      "text": "1．单选 · 旋转",
      "fontSize": 26,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1．单选 · 旋转",
      "autoResize": true,
      "lineHeight": 1.15,
      "labelPosition": null
    },
    {
      "id": "id3",
      "type": "text",
      "x": 80,
      "y": 348,
      "width": 478,
      "height": 64,
      "angle": 0,
      "strokeColor": "#1f2329",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "groupIds": [],
      "index": null,
      "roundness": null,
      "seed": 1,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "created": 1,
      "link": null,
      "locked": false,
      "text": "① 单击右边那个矩形选中它。\n② 把指针移到右下角外侧的旋转柄上（光标会变成旋转图标）。\n③ 按住拖一圈，中途按住 Shift 感受 15° 吸附。",
      "fontSize": 17,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① 单击右边那个矩形选中它。\n② 把指针移到右下角外侧的旋转柄上（光标会变成旋转图标）。\n③ 按住拖一圈，中途按住 Shift 感受 15° 吸附。",
      "autoResize": true,
      "lineHeight": 1.15,
      "labelPosition": null
    },
    {
      "id": "id4",
      "type": "text",
      "x": 80,
      "y": 426,
      "width": 463,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2329",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "groupIds": [],
      "index": null,
