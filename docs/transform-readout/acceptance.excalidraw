      "y": 2726,
      "width": 579,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2329",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "groupIds": [],
      "index": null,
      "roundness": null,
